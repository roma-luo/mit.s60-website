# Copy this file to .env and fill in your keys. .env is gitignored; never commit it.
DEEPSEEK_API_KEY=     # generation (api/chat.js) — required for live answers
OPENAI_API_KEY=       # embeddings (build-index.mjs + api/recall.js) — optional; BM25-only without it
# OPENAI_BASE_URL=    # only needed for relay/aggregator keys (default: https://api.openai.com/v1)
# OPENAI_EMBED_MODEL= # embedding model override (default: text-embedding-3-small)
